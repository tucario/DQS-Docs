---
import { render } from 'astro:content';
import { getCollection } from 'astro:content';

// Define page order matching sidebar
const pageOrder = [
	'index',
	'getting-started/installation',
	'getting-started/permissions',
	'getting-started/quick-start',
	'builder/overview',
	'builder/creating-definition',
	'builder/field-selection',
	'builder/capabilities',
	'builder/lifecycle',
	'capabilities/overview',
	'capabilities/completeness',
	'capabilities/validity',
	'capabilities/uniqueness',
	'capabilities/timeliness',
	'capabilities/consistency',
	'capabilities/pii-detection',
	'insight-studio/overview',
	'insight-studio/navigation',
	'insight-studio/scores-trends',
	'insight-studio/field-health',
	'insight-studio/actions',
	'insight-studio/exports',
	'processing/overview',
	'processing/scheduling',
	'processing/data-retention',
	'processing/error-management',
	'reference/data-model',
	'reference/limits',
	'reference/known-issues',
	'reference/faq',
];

// Section labels for dividers
const sectionLabels: Record<string, string> = {
	'index': 'Getting Started',
	'builder/overview': 'Builder',
	'capabilities/overview': 'Capabilities',
	'insight-studio/overview': 'Insight Studio',
	'processing/overview': 'Processing',
	'reference/data-model': 'Reference',
};

// Get all English docs
const allDocs = await getCollection('docs', (entry) => {
	// Only root-level English pages (no language prefix)
	return !entry.id.match(/^(de|fr|es|ja|pt|pl|ar)\//);
});

// Build ordered list, skipping regex-tester (interactive)
const orderedDocs = pageOrder
	.map((slug) => allDocs.find((doc) => doc.id === slug))
	.filter((doc): doc is NonNullable<typeof doc> => doc != null);

// Render all docs
const rendered = await Promise.all(
	orderedDocs.map(async (doc) => {
		const { Content } = await render(doc);
		return { doc, Content, section: sectionLabels[doc.id] };
	})
);
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Data Quality Sense Documentation — PDF</title>
	<meta name="robots" content="noindex" />
	<style>
		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		body {
			font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
			font-size: 11pt;
			line-height: 1.6;
			color: #1a1a2e;
			background: #fff;
			max-width: 800px;
			margin: 0 auto;
			padding: 2rem;
		}

		/* Print toolbar */
		.print-toolbar {
			position: sticky;
			top: 0;
			background: #fff;
			border-bottom: 1px solid #e2e8f0;
			padding: 1rem 0;
			margin-bottom: 2rem;
			display: flex;
			align-items: center;
			justify-content: space-between;
			z-index: 10;
		}

		.print-toolbar h2 {
			font-size: 1rem;
			color: #4338ca;
		}

		.print-btn {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			padding: 0.5rem 1.25rem;
			font-size: 0.875rem;
			font-weight: 500;
			color: #fff;
			background: #4338ca;
			border: none;
			border-radius: 0.5rem;
			cursor: pointer;
			transition: background 0.2s;
		}

		.print-btn:hover {
			background: #3730a3;
		}

		.print-btn svg {
			width: 16px;
			height: 16px;
			fill: none;
			stroke: currentColor;
			stroke-width: 2;
			stroke-linecap: round;
			stroke-linejoin: round;
		}

		/* Cover page */
		.cover {
			text-align: center;
			padding: 4rem 0 3rem;
			border-bottom: 2px solid #4338ca;
			margin-bottom: 3rem;
		}

		.cover h1 {
			font-size: 2rem;
			font-weight: 700;
			color: #1e1b4b;
			margin-bottom: 0.5rem;
		}

		.cover .subtitle {
			font-size: 1rem;
			color: #6366f1;
			margin-bottom: 1.5rem;
		}

		.cover .meta {
			font-size: 0.8rem;
			color: #94a3b8;
		}

		/* Table of contents */
		.toc {
			margin-bottom: 3rem;
			page-break-after: always;
		}

		.toc h2 {
			font-size: 1.25rem;
			color: #1e1b4b;
			margin-bottom: 1rem;
			padding-bottom: 0.5rem;
			border-bottom: 1px solid #e2e8f0;
		}

		.toc-section {
			margin-bottom: 0.75rem;
		}

		.toc-section-title {
			font-weight: 600;
			font-size: 0.9rem;
			color: #4338ca;
			margin-bottom: 0.25rem;
		}

		.toc-section ul {
			list-style: none;
			padding-left: 1.25rem;
		}

		.toc-section li {
			font-size: 0.85rem;
			color: #475569;
			line-height: 1.8;
		}

		.toc-section a {
			color: #475569;
			text-decoration: none;
		}

		.toc-section a:hover {
			color: #4338ca;
		}

		/* Section divider */
		.section-divider {
			margin: 3rem 0 2rem;
			padding: 0.75rem 1.25rem;
			background: #eef2ff;
			border-left: 4px solid #4338ca;
			font-size: 1.25rem;
			font-weight: 700;
			color: #1e1b4b;
			page-break-before: always;
		}

		/* Page content */
		.page-block {
			margin-bottom: 3rem;
			padding-bottom: 2rem;
			border-bottom: 1px solid #f1f5f9;
		}

		.page-block h1 {
			font-size: 1.5rem;
			color: #1e1b4b;
			margin-bottom: 1rem;
			padding-bottom: 0.5rem;
			border-bottom: 1px solid #e2e8f0;
		}

		.page-block h2 {
			font-size: 1.2rem;
			color: #312e81;
			margin-top: 1.5rem;
			margin-bottom: 0.75rem;
		}

		.page-block h3 {
			font-size: 1.05rem;
			color: #3730a3;
			margin-top: 1.25rem;
			margin-bottom: 0.5rem;
		}

		.page-block p {
			margin-bottom: 0.75rem;
		}

		.page-block ul, .page-block ol {
			margin-bottom: 0.75rem;
			padding-left: 1.5rem;
		}

		.page-block li {
			margin-bottom: 0.25rem;
		}

		.page-block img {
			max-width: 480px !important;
			width: auto !important;
			height: auto !important;
			border: 1px solid #e2e8f0;
			border-radius: 0.5rem;
			margin: 0.75rem 0;
			display: block;
			page-break-inside: avoid;
			break-inside: avoid;
		}

		.page-block table {
			width: 100%;
			border-collapse: collapse;
			margin: 1rem 0;
			font-size: 0.9rem;
		}

		.page-block th, .page-block td {
			border: 1px solid #e2e8f0;
			padding: 0.5rem 0.75rem;
			text-align: left;
		}

		.page-block th {
			background: #f8fafc;
			font-weight: 600;
		}

		.page-block code {
			font-family: 'SF Mono', 'Fira Code', monospace;
			font-size: 0.85em;
			background: #f1f5f9;
			padding: 0.15em 0.35em;
			border-radius: 0.25rem;
		}

		.page-block pre {
			background: #1e1b4b;
			color: #e2e8f0;
			padding: 1rem;
			border-radius: 0.5rem;
			overflow-x: auto;
			margin: 1rem 0;
			font-size: 0.85rem;
			page-break-inside: avoid;
		}

		.page-block pre code {
			background: none;
			padding: 0;
			color: inherit;
		}

		.page-block a {
			color: #4338ca;
			text-decoration: underline;
		}

		/* Aside boxes */
		.starlight-aside {
			border: 1px solid #e2e8f0;
			border-left: 4px solid #6366f1;
			border-radius: 0.5rem;
			padding: 0.75rem 1rem;
			margin: 1rem 0;
			background: #fafbff;
			page-break-inside: avoid;
		}

		.starlight-aside--tip {
			border-left-color: #22c55e;
		}

		.starlight-aside--caution {
			display: none;
		}

		.starlight-aside--danger {
			border-left-color: #ef4444;
		}

		.starlight-aside__title {
			font-weight: 600;
			font-size: 0.9rem;
			margin-bottom: 0.25rem;
		}

		/* Hide interactive elements */
		.link-card,
		.sl-link-card,
		a.link-card,
		.card-grid,
		.regex-tester {
			display: none !important;
		}

		/* Hide heading anchor links ("Section titled ...") */
		.sl-anchor-link {
			display: none !important;
		}

		/* Hide heading wrapper flex layout that creates extra space */
		.sl-heading-wrapper {
			display: block;
		}

		/* Videos hidden */
		video {
			display: none;
		}

		@media print {
			.print-toolbar {
				display: none;
			}

			body {
				padding: 0;
				max-width: 100%;
			}

			.page-block img {
				max-width: 480px !important;
				width: auto !important;
				height: auto !important;
			}
		}
	</style>
</head>
<body>
	<div class="print-toolbar">
		<h2>Data Quality Sense Documentation</h2>
		<button class="print-btn" onclick="window.print()">
			<svg viewBox="0 0 24 24"><path d="M12 3v12m0 0l-4-4m4 4l4-4"/><path d="M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/></svg>
			Download PDF
		</button>
	</div>

	<div class="cover">
		<h1>Data Quality Sense</h1>
		<p class="subtitle">Salesforce-native Data Quality Management</p>
		<p class="meta">Documentation &bull; {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}</p>
	</div>

	<div class="toc">
		<h2>Table of Contents</h2>
		{Object.entries(sectionLabels).map(([firstSlug, label]) => {
			const sectionPages = orderedDocs.filter((doc) => {
				const idx = pageOrder.indexOf(doc.id);
				const sectionIdx = pageOrder.indexOf(firstSlug);
				const nextSectionSlug = Object.keys(sectionLabels).find(
					(s) => pageOrder.indexOf(s) > sectionIdx
				);
				const nextIdx = nextSectionSlug ? pageOrder.indexOf(nextSectionSlug) : pageOrder.length;
				return idx >= sectionIdx && idx < nextIdx;
			});
			return (
				<div class="toc-section">
					<div class="toc-section-title">{label}</div>
					<ul>
						{sectionPages.map((doc) => (
							<li><a href={`#${doc.id.replace(/\//g, '-')}`}>{doc.data.title}</a></li>
						))}
					</ul>
				</div>
			);
		})}
	</div>

	{rendered.map(({ doc, Content, section }) => (
		<>
			{section && <div class="section-divider">{section}</div>}
			<div class="page-block" id={doc.id.replace(/\//g, '-')}>
				<h1>{doc.data.title}</h1>
				<Content />
			</div>
		</>
	))}
</body>
</html>
